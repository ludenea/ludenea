// The compute stage of a lit shader: the engine's template for a pass with
// no rasterizer, as the shading of a visibility buffer is. For each pixel it
// takes the triangle that covers the pixel's centre, computes the weights of
// its three corners, corrected for perspective, with their derivatives
// across the target, and hands the surface function its inputs, each
// coordinate with the differentials computed from those derivatives.
// Composed by text after the lighting module, compiled with
// `DIFFERENTIALS_ARE_SUPPLIED`, and the surface: the composition supplies
// the version line.
layout(local_size_x = 8, local_size_y = 8) in;

struct Corner {
    vec4 position;
    vec4 normal;
    vec4 uv;
};

layout(set = 2, binding = 0) uniform Geometry {
    // The centre of the pixel (x, y) is, in normalized device coordinates,
    // (x + 0.5, y + 0.5) * pixel_to_device.xy + pixel_to_device.zw.
    vec4 pixel_to_device;
    // Two triangles, three corners each, with the bytes of the vertices the
    // raster pass draws.
    Corner corners[6];
} geometry;

layout(rgba8, set = 2, binding = 1) uniform writeonly image2D lit_image;

// What the vertex stage does to a corner: the position its material moves
// it to, and the homogeneous position the rasterizer would divide.
vec3 corner_moved(int index) {
    vec3 at = geometry.corners[index].position.xyz;
    return at + surface_offset(at, geometry.corners[index].normal.xyz);
}

vec3 corner_homogeneous(int index) {
    vec3 moved = corner_moved(index);
    return vec3(moved.x, -moved.y, geometry.corners[index].position.w);
}

// The lit color of the triangle that starts at the corner `first`, at a
// point of the target; an alpha of zero where the triangle does not cover
// the point.
vec4 shade(int first, vec2 device) {
    vec3 a = corner_homogeneous(first);
    vec3 b = corner_homogeneous(first + 1);
    vec3 c = corner_homogeneous(first + 2);
    // The edge functions of a triangle in homogeneous coordinates: the
    // weight of a corner at a point is the point against the plane through
    // the two other corners, and the weights divided by their sum are the
    // perspective-correct ones.
    vec3 edge_a = cross(b, c);
    vec3 edge_b = cross(c, a);
    vec3 edge_c = cross(a, b);
    float facing = dot(a, edge_a) < 0.0 ? -1.0 : 1.0;
    vec3 point = vec3(device, 1.0);
    vec3 weights = facing * vec3(dot(point, edge_a), dot(point, edge_b), dot(point, edge_c));
    bool covered = weights.x >= 0.0 && weights.y >= 0.0 && weights.z >= 0.0;
    float sum = weights.x + weights.y + weights.z;
    float total = covered && sum > 0.0 ? sum : 1.0;
    vec3 corrected = weights / total;
    // The derivatives of the weights along the target's two axes, per pixel.
    vec3 weights_dx = facing * vec3(edge_a.x, edge_b.x, edge_c.x) * geometry.pixel_to_device.x;
    vec3 weights_dy = facing * vec3(edge_a.y, edge_b.y, edge_c.y) * geometry.pixel_to_device.y;
    vec3 corrected_dx = (weights_dx * total - weights * (weights_dx.x + weights_dx.y + weights_dx.z)) / (total * total);
    vec3 corrected_dy = (weights_dy * total - weights * (weights_dy.x + weights_dy.y + weights_dy.z)) / (total * total);

    vec2 uv_a = geometry.corners[first].uv.xy;
    vec2 uv_b = geometry.corners[first + 1].uv.xy;
    vec2 uv_c = geometry.corners[first + 2].uv.xy;
    SurfaceInput inputs;
    inputs.uv = Coordinate(
        uv_a * corrected.x + uv_b * corrected.y + uv_c * corrected.z,
        uv_a * corrected_dx.x + uv_b * corrected_dx.y + uv_c * corrected_dx.z,
        uv_a * corrected_dy.x + uv_b * corrected_dy.y + uv_c * corrected_dy.z);
    inputs.position = corner_moved(first) * corrected.x + corner_moved(first + 1) * corrected.y + corner_moved(first + 2) * corrected.z;
    inputs.normal = geometry.corners[first].normal.xyz * corrected.x + geometry.corners[first + 1].normal.xyz * corrected.y + geometry.corners[first + 2].normal.xyz * corrected.z;
    vec4 lit = vec4(light_surface(surface(inputs), inputs.position), 1.0);
    return covered ? lit : vec4(0.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    vec2 device = (vec2(pixel) + 0.5) * geometry.pixel_to_device.xy + geometry.pixel_to_device.zw;
    vec4 first = shade(0, device);
    vec4 second = shade(3, device);
    imageStore(lit_image, pixel, first.a > 0.0 ? first : second);
}
