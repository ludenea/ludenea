{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    // Generated by `pnpm build:render`; tests use test/fake-render-wasm.ts instead
    // (vitest.config.ts).
    "paths": {
      "@ludenea/render-wasm": ["../render-wasm/ludenea_render"]
    }
  },
  "include": ["src", "test"],
  "references": [{ "path": "../control-client" }, { "path": "../editor-shell" }]
}
