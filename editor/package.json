{
  "name": "ludenea-editor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:wasm": "cargo xtask wasm-renderer packages/debug-draw-wasm",
    "build:render": "cargo xtask wasm-render packages/render-wasm",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "pnpm -r build",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@typescript/typescript6": "6.0.2",
    "rollup": "4.64.7",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
